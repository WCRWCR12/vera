{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.claude/channels/telegram/.env)",
      "Edit(~/.claude/channels/telegram/.env)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude/projects/**/*.jsonl)",
      "Read(~/Vera/screen/.token)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Bash(*telegram/.env*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(* | sh)",
      "Bash(* | bash)",
      "Bash(*dangerously-skip-permissions*)",
      "Bash(schtasks *)",
      "Bash(launchctl *)",
      "Bash(reg add *)"
    ]
  }
}
