{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "Edit(./*.md)",
      "Edit(./inbox/**)",
      "Edit(./workflows/**)",
      "Edit(./screen/data/*.json)"
    ],
    "ask": [
      "Edit(./CLAUDE.md)",
      "Edit(./persona.md)",
      "Edit(./people.md)",
      "Edit(./preferences.md)",
      "Edit(./protocols/**)",
      "Edit(~/.claude/channels/telegram/access.json)",
      "Bash(rm -rf *)",
      "Bash(chmod *)",
      "Bash(xattr *)",
      "Bash(osascript *)",
      "Bash(crontab *)",
      "Bash(launchctl *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(node -e *)",
      "PowerShell"
    ],
    "deny": [
      "Read(./screen/.token)",
      "Read(~/.claude/channels/telegram/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/.env)",
      "Read(~/.claude/skills/.env)",
      "Read(~/.claude/projects/**/*.jsonl)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Group Containers/**)",
      "Read(~/Library/Containers/**)",
      "Read(~/Library/Application Support/Claude/**)",
      "Read(~/Library/Application Support/1Password/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/BraveSoftware/**)",
      "Read(~/Library/Application Support/Microsoft Edge/**)",
      "Read(~/Library/Application Support/Arc/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/AppData/Local/Google/Chrome/User Data/**)",
      "Read(~/AppData/Local/Microsoft/Edge/User Data/**)",
      "Read(~/AppData/Local/BraveSoftware/**)",
      "Read(~/AppData/Roaming/Mozilla/Firefox/Profiles/**)",
      "Read(~/AppData/Roaming/Claude/**)",
      "Read(~/AppData/Local/1Password/**)",
      "Read(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Credentials/**)",
      "Read(~/AppData/Roaming/Microsoft/Protect/**)",
      "Edit(./.claude/**)",
      "Edit(./vera-settings.json)",
      "Edit(./.mcp.json)",
      "Edit(./start-vera.cmd)",
      "Edit(./start-vera.command)",
      "Edit(./start-screen.cmd)",
      "Edit(./start-screen.command)",
      "Edit(./tools/**)",
      "Edit(./screen/server.py)",
      "Edit(./screen/web/**)",
      "Edit(./screen/.token)",
      "Edit(~/.claude/channels/telegram/.env)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.zlogin)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/AppData/Roaming/Microsoft/Windows/Start Menu/Programs/Startup/**)",
      "Edit(~/Documents/WindowsPowerShell/**)",
      "Edit(~/Documents/PowerShell/**)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | zsh*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(* | sh)",
      "Bash(* | bash)",
      "Bash(* | zsh)",
      "Bash(bash <(curl*)",
      "Bash(sh <(curl*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(security *)",
      "Bash(csrutil *)",
      "Bash(spctl *)",
      "Bash(defaults write *)",
      "Bash(dscl *)",
      "Bash(reg *)",
      "Bash(schtasks *)",
      "Bash(icacls *)",
      "Bash(takeown *)",
      "Bash(*~/.ssh*)",
      "Bash(*~/.aws*)",
      "Bash(*Keychains*)",
      "Bash(*Cookies*)",
      "Bash(*telegram/.env*)",
      "Bash(*.credentials.json*)",
      "Bash(*screen/.token*)",
      "Bash(*>> ~/.zshrc*)",
      "Bash(*> ~/.zshrc*)",
      "Bash(*>> ~/.bash_profile*)",
      "Bash(*>> ~/.zprofile*)",
      "Bash(*>> ~/.profile*)",
      "Bash(*>> ~/.bashrc*)"
    ]
  }
}
