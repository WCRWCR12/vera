{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "cleanupPeriodDays": 30,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.claude/channels/telegram/.env)",
      "Read(~/.claude/channels/telegram/access.json)",
      "Read(~/.claude/channels/telegram/approved/**)",
      "Edit(~/.claude/channels/telegram/.env)",
      "Edit(~/.claude/channels/telegram/access.json)",
      "Edit(~/.claude/channels/telegram/approved/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/AppData/Roaming/Microsoft/Windows/Start Menu/Programs/Startup/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./persona.md)",
      "Edit(./people.md)",
      "Edit(./preferences.md)",
      "Edit(./protocols/**)",
      "Edit(./.claude/**)",
      "Edit(./vera-settings.json)",
      "Edit(./start-vera.cmd)",
      "Edit(./start-vera.command)",
      "Edit(./start-screen.cmd)",
      "Edit(./start-screen.command)",
      "Edit(./tools/**)",
      "Edit(./screen/server.py)",
      "Edit(./screen/web/**)",
      "Read(./screen/.token)",
      "Edit(./screen/.token)",
      "PowerShell",
      "Bash(*telegram/.env*)",
      "Bash(*access.json*)",
      "Bash(*telegram/approved*)",
      "Bash(*screen/.token*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "Bash(crontab *)",
      "Bash(launchctl *)",
      "Bash(schtasks *)",
      "Bash(reg *)",
      "Bash(osascript *)",
      "Bash(chmod *)",
      "Bash(icacls *)",
      "Bash(xattr *)",
      "Bash(npx *)",
      "Bash(bunx *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(brew install *)",
      "Bash(winget *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(node -e *)",
      "Bash(powershell *)",
      "Bash(pwsh *)"
    ]
  }
}
